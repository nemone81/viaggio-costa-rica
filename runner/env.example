# Copia in /root/runner-viaggi/env (chmod 600) e compila.

# Fine-grained PAT sul solo repo nemone81/viaggio-costa-rica:
# Contents read/write, Pull requests read/write, Issues read/write.
GITHUB_TOKEN=github_pat_...

# Token dell'abbonamento per Claude Code headless: `claude setup-token` sul VPS,
# eseguito come utente runner.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat...

REPO=nemone81/viaggio-costa-rica
SITE=https://viaggi.fabiocrestoni.it

# Facoltativo: watchdog. Se il runner smette di girare arriva una email.
# HEALTHCHECK_URL_RUNNER=https://hc-ping.com/xxxxxxxx
